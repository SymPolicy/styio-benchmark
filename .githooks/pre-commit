#!/bin/sh
set -eu
repo_root="$(git rev-parse --show-toplevel)"
auditor_root="${GENERAL_AUDITOR_ROOT:?Set GENERAL_AUDITOR_ROOT to a trusted General-Auditor checkout on only}"
report="$(git rev-parse --git-path general-auditor/staged.json)"
python3 -I "$auditor_root/action_entry.py" scan --policy-root "$auditor_root" \
  --directory "$repo_root" --repository "SymPolicy/styio-benchmark" --scope staged --output "$report"

git_common_dir="$(git rev-parse --git-common-dir)"
legacy_hook="$git_common_dir/hooks/pre-commit"
if [ -x "$legacy_hook" ]; then
  "$legacy_hook" "$@"
fi
